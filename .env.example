# ==============================================================================
# VERDICT Configuration
# ==============================================================================

# LLM Provider: 'groq' or 'fake'
LLM_PROVIDER=groq

# Groq Settings (required if LLM_PROVIDER=groq)
# Get your API key from https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Embedder Settings
# Options: 'BAAI/bge-small-en-v1.5' (or any SentenceTransformer model) or 'fake'
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Ingestion / Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Retrieval Settings
TOP_K=6
# Minimum RRF or similarity score required before querying LLM. If below this, pipeline abstains.
RETRIEVAL_MIN_SCORE=0.01

# Persistence
CHROMA_DIR=./chroma_db

# Logging
LOG_LEVEL=INFO
